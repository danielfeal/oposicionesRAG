# Copy to .env (gitignored) and fill in real values.

# Escape any literal "$" in a value as "$$", or Docker Compose will silently 
# blank out whatever follows it as an "undefined variable".

# Generate with: chainlit create-secret
CHAINLIT_AUTH_SECRET=

# One or more "username:salt_hex:hash_hex" records separated by "|".
# Generate one record per user with: python scripts/hash_password.py
CHAINLIT_USERS=
